# PostgreSQL connection used only on the server.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/duesoon?schema=public"

# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-generated-secret"

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TIMETABLE_ENCRYPTION_KEY="replace-with-a-base64-encoded-32-byte-key"
