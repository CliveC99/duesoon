# Copy this file to .env on the Mini PC. Never commit the populated file.
POSTGRES_DB=duesoon
POSTGRES_USER=duesoon
POSTGRES_PASSWORD=replace-with-a-long-random-password

# The password must be URL-encoded here if it contains reserved URL characters.
DATABASE_URL=postgresql://duesoon:replace-with-a-long-random-password@duesoon-db:5432/duesoon?schema=public

# Generate with: npx auth secret
AUTH_SECRET=replace-with-a-generated-secret

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TIMETABLE_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Required for Auth.js behind a trusted reverse proxy. The proxy must replace,
# rather than append untrusted client values to, forwarded host/protocol headers.
AUTH_TRUST_HOST=true

# Loopback port consumed by the host reverse proxy.
DUESOON_PORT=3000
