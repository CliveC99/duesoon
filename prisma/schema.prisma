generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String           @id @default(cuid())
  name                   String?
  email                  String           @unique
  emailVerified          DateTime?
  image                  String?
  passwordHash           String?
  accounts               Account[]
  sessions               Session[]
  semesters              Semester[]
  modules                Module[]
  deadlines              Deadline[]
  deadlineSubtasks       DeadlineSubtask[]
  deadlineResources      DeadlineResource[]
  ownedGroups            Group[]          @relation("GroupOwner")
  groupMemberships       GroupMember[]
  sharedDeadlinesCreated SharedDeadline[] @relation("SharedDeadlineCreator")
  timetableSource        TimetableSource?
  timetableEvents        TimetableEvent[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
}

model TimetableSource {
  id                String              @id @default(cuid())
  userId            String              @unique
  feedCiphertext    Bytes
  feedIv            Bytes
  feedAuthTag       Bytes
  lastSyncedAt      DateTime?
  lastSyncStatus    TimetableSyncStatus @default(PENDING)
  lastSyncErrorSafe String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  events            TimetableEvent[]

  @@unique([id, userId])
  @@index([userId, lastSyncStatus])
}

model TimetableEvent {
  id              String               @id @default(cuid())
  userId          String
  sourceId        String
  externalUid     String
  recurrenceKey   String
  title           String
  description     String?
  location        String?
  startAt         DateTime
  endAt           DateTime
  allDay          Boolean              @default(false)
  status          TimetableEventStatus @default(CONFIRMED)
  sourceUpdatedAt DateTime?
  sequence        Int?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  source          TimetableSource      @relation(fields: [sourceId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([sourceId, userId, externalUid, recurrenceKey])
  @@index([userId, startAt])
  @@index([sourceId, startAt])
}

enum TimetableSyncStatus {
  PENDING
  SYNCING
  SUCCESS
  FAILED
}

enum TimetableEventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

model Semester {
  id           String   @id @default(cuid())
  userId       String
  name         String
  academicYear String
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  modules      Module[]

  @@unique([id, userId])
  @@index([userId])
  @@index([userId, isActive])
}

model Module {
  id         String     @id @default(cuid())
  userId     String
  semesterId String?
  name       String
  code       String?
  colour     String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester   Semester?  @relation(fields: [semesterId, userId], references: [id, userId], onDelete: Restrict)
  deadlines  Deadline[]

  @@unique([id, userId])
  @@index([userId])
  @@index([semesterId, userId])
}

model Deadline {
  id                 String          @id @default(cuid())
  userId             String
  moduleId           String
  sharedDeadlineId   String?
  title              String
  type               DeadlineType
  dueAt              DateTime
  reminderDaysBefore Int?
  weighting          Int?
  resultPercent      Float?
  resultRecordedAt   DateTime?
  status             DeadlineStatus  @default(NOT_STARTED)
  notes              String?
  examTopics         String?
  examFormat         String?
  examLocation       String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  module             Module          @relation(fields: [moduleId, userId], references: [id, userId], onDelete: Restrict)
  sharedDeadline     SharedDeadline? @relation(fields: [sharedDeadlineId], references: [id], onDelete: SetNull)
  subtasks           DeadlineSubtask[]
  resources          DeadlineResource[]

  @@unique([id, userId])
  @@unique([userId, sharedDeadlineId])
  @@index([userId, dueAt])
  @@index([moduleId, userId])
  @@index([sharedDeadlineId])
}

model DeadlineSubtask {
  id          String   @id @default(cuid())
  deadlineId  String
  userId      String
  title       String
  isCompleted Boolean  @default(false)
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deadline    Deadline @relation(fields: [deadlineId, userId], references: [id, userId], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deadlineId, userId, position])
  @@index([userId])
}

model DeadlineResource {
  id         String   @id @default(cuid())
  deadlineId String
  userId     String
  label      String
  url        String
  position   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deadline   Deadline @relation(fields: [deadlineId, userId], references: [id, userId], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deadlineId, userId, position])
  @@index([userId])
}

model Group {
  id              String           @id @default(cuid())
  name            String
  ownerId         String
  inviteToken     String?          @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  owner           User             @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members         GroupMember[]
  sharedDeadlines SharedDeadline[]

  @@index([ownerId])
}

model GroupMember {
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model SharedDeadline {
  id          String       @id @default(cuid())
  groupId     String
  createdById String
  title       String
  type        DeadlineType
  dueAt       DateTime
  weighting   Int?
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("SharedDeadlineCreator", fields: [createdById], references: [id], onDelete: Restrict)
  deadlines   Deadline[]

  @@index([groupId, dueAt])
  @@index([createdById])
}

enum GroupRole {
  OWNER
  MEMBER
}

enum DeadlineType {
  ASSIGNMENT
  EXAM
  QUIZ
  PROJECT
  LAB
  PRESENTATION
  CONTINUOUS_ASSESSMENT
  OTHER
}

enum DeadlineStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
