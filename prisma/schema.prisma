generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String           @id @default(cuid())
  name                   String?
  email                  String           @unique
  emailVerified          DateTime?
  image                  String?
  passwordHash           String?
  accounts               Account[]
  sessions               Session[]
  semesters              Semester[]
  modules                Module[]
  deadlines              Deadline[]
  ownedGroups            Group[]          @relation("GroupOwner")
  groupMemberships       GroupMember[]
  sharedDeadlinesCreated SharedDeadline[] @relation("SharedDeadlineCreator")
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
}

model Semester {
  id           String   @id @default(cuid())
  userId       String
  name         String
  academicYear String
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  modules      Module[]

  @@unique([id, userId])
  @@index([userId])
  @@index([userId, isActive])
}

model Module {
  id         String     @id @default(cuid())
  userId     String
  semesterId String?
  name       String
  code       String?
  colour     String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester   Semester?  @relation(fields: [semesterId, userId], references: [id, userId], onDelete: Restrict)
  deadlines  Deadline[]

  @@unique([id, userId])
  @@index([userId])
  @@index([semesterId, userId])
}

model Deadline {
  id                 String          @id @default(cuid())
  userId             String
  moduleId           String
  sharedDeadlineId   String?
  title              String
  type               DeadlineType
  dueAt              DateTime
  reminderDaysBefore Int?
  weighting          Int?
  resultPercent      Float?
  resultRecordedAt   DateTime?
  status             DeadlineStatus  @default(NOT_STARTED)
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  module             Module          @relation(fields: [moduleId, userId], references: [id, userId], onDelete: Restrict)
  sharedDeadline     SharedDeadline? @relation(fields: [sharedDeadlineId], references: [id], onDelete: SetNull)

  @@unique([userId, sharedDeadlineId])
  @@index([userId, dueAt])
  @@index([moduleId, userId])
  @@index([sharedDeadlineId])
}

model Group {
  id              String           @id @default(cuid())
  name            String
  ownerId         String
  inviteToken     String?          @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  owner           User             @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members         GroupMember[]
  sharedDeadlines SharedDeadline[]

  @@index([ownerId])
}

model GroupMember {
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model SharedDeadline {
  id          String       @id @default(cuid())
  groupId     String
  createdById String
  title       String
  type        DeadlineType
  dueAt       DateTime
  weighting   Int?
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("SharedDeadlineCreator", fields: [createdById], references: [id], onDelete: Restrict)
  deadlines   Deadline[]

  @@index([groupId, dueAt])
  @@index([createdById])
}

enum GroupRole {
  OWNER
  MEMBER
}

enum DeadlineType {
  ASSIGNMENT
  EXAM
  QUIZ
  PROJECT
  LAB
  PRESENTATION
  CONTINUOUS_ASSESSMENT
  OTHER
}

enum DeadlineStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
