generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
  semesters     Semester[]
  modules       Module[]
  deadlines     Deadline[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Semester {
  id           String   @id @default(cuid())
  userId       String
  name         String
  academicYear String
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  modules      Module[]

  @@unique([id, userId])
  @@index([userId])
  @@index([userId, isActive])
}

model Module {
  id         String     @id @default(cuid())
  userId     String
  semesterId String?
  name       String
  code       String?
  colour     String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester   Semester?  @relation(fields: [semesterId, userId], references: [id, userId], onDelete: Restrict)
  deadlines  Deadline[]

  @@unique([id, userId])
  @@index([userId])
  @@index([semesterId, userId])
}

model Deadline {
  id                 String         @id @default(cuid())
  userId             String
  moduleId           String
  title              String
  type               DeadlineType
  dueAt              DateTime
  reminderDaysBefore Int?
  weighting          Int?
  resultPercent      Float?
  resultRecordedAt   DateTime?
  status             DeadlineStatus @default(NOT_STARTED)
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  module             Module         @relation(fields: [moduleId, userId], references: [id, userId], onDelete: Restrict)

  @@index([userId, dueAt])
  @@index([moduleId, userId])
}

enum DeadlineType {
  ASSIGNMENT
  EXAM
  QUIZ
  PROJECT
  LAB
  PRESENTATION
  CONTINUOUS_ASSESSMENT
  OTHER
}

enum DeadlineStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
